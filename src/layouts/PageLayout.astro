---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, resolvePageContextFromPath, type PageId } from '../data/i18n/routing';
import { destinyImages } from '../data/destiny';
import {
	heroPreloadSrc,
	heroSizes,
	heroSrcSet,
	heroWidth,
	heroHeight,
	contentSrcSet,
	galleryTileSizes,
} from '../lib/responsive-images';
import { defaultLocale } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';

type GalleryInput = string | { src: string; alt: string };

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	heading: string;
	intro: string;
	eyebrow?: string;
	heroImage?: string;
	heroAlt?: string;
	gallery?: ReadonlyArray<GalleryInput>;
	galleryTitle?: string;
	ctaPrimary?: { href: string; label: string; edit?: string };
	ctaSecondary?: { href: string; label: string };
	introEdit?: string;
	showGallery?: boolean;
	showBanner?: boolean;
	locale?: import('../data/i18n/locales').LocaleCode;
	pageId?: import('../data/i18n/content.generated').PageId;
	extraGraph?: Record<string, unknown>[];
}

const {
	title,
	description,
	canonicalPath = '/',
	heading,
	intro,
	eyebrow,
	heroImage = destinyImages.hero,
	heroAlt,
	gallery = destinyImages.product.slice(0, 3),
	galleryTitle,
	ctaPrimary,
	ctaSecondary,
	introEdit,
	showGallery = true,
	showBanner = true,
	locale = defaultLocale,
	pageId: pageIdProp,
	extraGraph = [],
} = Astro.props;

const heroVideo = siteConfig.heroVideo?.trim() || '';

const t = getT(locale);
const resolvedHeroAlt =
	(heroAlt && heroAlt.trim()) ||
	t('images.hero') ||
	`${siteConfig.name} — Destiny 2 ESP and aimbot`;
const resolvedGalleryTitle = galleryTitle ?? t('common.inGameLook');

function resolvePageId(path: string): PageId | undefined {
	return resolvePageContextFromPath(path).pageId;
}

const pageId = pageIdProp ?? resolvePageId(canonicalPath);
const ui = getUi(locale);
const homeHref = getLocalizedPath('home', locale);
const resolvedEyebrow = eyebrow ?? ui.product.title;
const showEyebrow =
	Boolean(resolvedEyebrow) && resolvedEyebrow.trim().toLowerCase() !== heading.trim().toLowerCase();

const normalizedGallery = gallery
	.map((item) => {
		if (typeof item !== 'string') {
			const alt = item.alt?.trim() || resolvedHeroAlt;
			return { src: item.src, alt };
		}
		return { src: item, alt: resolvedHeroAlt };
	})
	.filter((item) => Boolean(item.src));

const breadcrumbs = [
	{ label: ui.nav.home, href: homeHref },
	{ label: heading },
];

---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={heroImage}
	ogImageAlt={resolvedHeroAlt}
	breadcrumbs={breadcrumbs}
	locale={locale}
	pageId={pageId}
	extraGraph={extraGraph}
	lcpImage={showBanner && !heroVideo ? heroPreloadSrc : undefined}
	lcpImageSrcSet={showBanner && !heroVideo ? heroSrcSet : undefined}
	lcpImageSizes={showBanner && !heroVideo ? heroSizes : undefined}
	lcpVideo={showBanner && heroVideo ? heroVideo : undefined}
>
	<Navbar locale={locale} pageId={pageId} />
	<main id="main-content" class="page">
		{
			showBanner ? (
				<section class="banner">
					<div class="banner__media">
						{heroVideo ? (
							<video
								class="banner__img banner__video"
								src={heroVideo}
								autoplay
								muted
								loop
								playsinline
								preload="auto"
								width={heroWidth}
								height={heroHeight}
								aria-hidden="true"
							/>
						) : (
							<img
								src={heroPreloadSrc}
								srcset={heroSrcSet}
								sizes={heroSizes}
								alt={resolvedHeroAlt}
								width={heroWidth}
								height={heroHeight}
								class="banner__img"
								fetchpriority="high"
								loading="eager"
								decoding="async"
							/>
						)}
						<div class="banner__scrim" aria-hidden="true" />
					</div>

					<div class="shell banner__shell">
						<div class="banner__content">
							<nav class="banner__crumbs" aria-label={t('common.breadcrumb')}>
								<a href={homeHref}>{ui.nav.home}</a>
								<span aria-hidden="true">/</span>
								<span aria-current="page">{heading}</span>
							</nav>
							{showEyebrow && <p class="banner__eyebrow">{resolvedEyebrow}</p>}
							<h1 class="banner__title">{heading}</h1>
							<p class="banner__intro" data-edit={introEdit || undefined}>
								{intro}
							</p>
							{(ctaPrimary || ctaSecondary) && (
								<div class="banner__actions">
									{ctaPrimary && (
										<a
											class="btn-buy"
											href={ctaPrimary.href}
											rel={ctaPrimary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											<span data-edit={ctaPrimary.edit || undefined}>{ctaPrimary.label}</span>
										</a>
									)}
									{ctaSecondary && (
										<a
											class="btn btn--ghost banner__btn-ghost"
											href={ctaSecondary.href}
											rel={ctaSecondary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											{ctaSecondary.label}
										</a>
									)}
								</div>
							)}
						</div>
					</div>
				</section>
			) : (
				<div class="shell page__head">
					<nav class="page__crumbs" aria-label={t('common.breadcrumb')}>
						<a href={homeHref}>{ui.nav.home}</a>
						<span aria-hidden="true">/</span>
						<span aria-current="page">{heading}</span>
					</nav>
					<h1 class="page__title">{heading}</h1>
					<p class="page__intro" data-edit={introEdit || undefined}>
						{intro}
					</p>
					{(ctaPrimary || ctaSecondary) && (
						<div class="page__actions">
							{ctaPrimary && (
								<a
									class="btn-buy"
									href={ctaPrimary.href}
									rel={ctaPrimary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									<span data-edit={ctaPrimary.edit || undefined}>{ctaPrimary.label}</span>
								</a>
							)}
							{ctaSecondary && (
								<a
									class="btn btn--ghost"
									href={ctaSecondary.href}
									rel={ctaSecondary.href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{ctaSecondary.label}
								</a>
							)}
						</div>
					)}
				</div>
			)
		}

		<div class="shell page__wrap">
			<article class="article">
				<slot />
			</article>

			{
				showGallery && normalizedGallery.length > 0 && (
					<section class="gallery-block" aria-labelledby="page-gallery-title">
						<header class="gallery-block__head">
							<p class="gallery-block__eyebrow">{t('common.gallery')}</p>
							<h2 id="page-gallery-title">{resolvedGalleryTitle}</h2>
						</header>
						<div class="gallery-block__grid">
							{normalizedGallery.map((image) => (
								<figure class="gallery-block__item">
									<img
										src={image.src}
										srcset={contentSrcSet(image.src)}
										sizes={galleryTileSizes}
										alt={image.alt}
										width="800"
										height="500"
										loading="lazy"
										decoding="async"
									/>
								</figure>
							))}
						</div>
					</section>
				)
			}
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

{heroVideo && showBanner ? <script is:inline src="/hero-video.js"></script> : null}

<style>
	.page {
		overflow-x: clip;
		padding-bottom: calc(3rem + env(safe-area-inset-bottom, 0px));
	}

	.banner {
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: end;
		overflow: hidden;
		border-bottom: 1px solid var(--line-soft);
		background: #0D0A14;
		aspect-ratio: 3.15 / 1;
		min-height: clamp(14rem, 28vw, 20rem);
		width: 100%;
	}

	.banner__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.banner__media picture,
	.banner__img,
	.banner__video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: right 28%;
	}

	.banner__video {
		background: #0D0A14;
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.banner__video.is-ready {
		opacity: 1;
	}

	.banner__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgba(8, 9, 10, 0.94) 0%,
			rgba(8, 9, 10, 0.72) 42%,
			rgba(8, 9, 10, 0.25) 100%
		);
	}

	.banner__shell {
		position: relative;
		z-index: 1;
		padding-block: clamp(2.25rem, 4.5vw, 3.25rem) clamp(1.5rem, 3vw, 2.25rem);
	}

	.banner__content {
		width: min(100%, 34rem);
	}

	.banner__crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		color: color-mix(in srgb, #fff 58%, transparent);
	}

	.banner__crumbs a {
		color: color-mix(in srgb, #fff 82%, transparent);
		font-weight: 600;
	}

	.banner__crumbs a:hover {
		color: #fff;
	}

	.banner__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--magenta-soft) 88%, #fff);
	}

	.banner__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3.6vw, 2.4rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: #fff;
	}

	.banner__intro {
		margin: 0.7rem 0 0;
		color: color-mix(in srgb, #fff 78%, transparent);
		font-size: 0.975rem;
		line-height: 1.55;
	}

	.banner__btn-ghost {
		border-color: color-mix(in srgb, #fff 35%, transparent);
		color: #fff;
		background: color-mix(in srgb, #fff 8%, transparent);
	}

	.banner__btn-ghost:hover {
		border-color: color-mix(in srgb, #fff 65%, transparent);
		color: #fff;
		background: color-mix(in srgb, #fff 14%, transparent);
	}

	.page__head {
		padding-block: clamp(1.75rem, 3vw, 2.5rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
		max-width: var(--content-max);
	}

	.page__crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.page__crumbs a {
		color: var(--ink-muted);
		font-weight: 600;
	}

	.page__crumbs a:hover {
		color: var(--magenta-soft);
	}

	.page__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.65rem, 3.2vw, 2.15rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.12;
		color: var(--ink);
	}

	.page__intro {
		margin: 0.65rem 0 0;
		color: var(--ink-muted);
		font-size: 0.975rem;
		line-height: 1.55;
		max-width: 40rem;
	}

	.page__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.1rem;
	}

	.banner__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.2rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.65rem 1.15rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.btn--ghost {
		border: 1px solid var(--line);
		color: var(--ink);
		background: var(--bg-panel);
	}

	.btn--ghost:hover {
		border-color: var(--magenta-soft);
		color: var(--magenta-soft);
	}

	.page__wrap {
		display: grid;
		gap: 2rem;
		padding-block: clamp(1.5rem, 3vw, 2.25rem) 3rem;
	}

	.article {
		width: min(100%, var(--content-max));
		display: grid;
		gap: 0.75rem;
		color: var(--ink-muted);
		line-height: 1.55;
	}

	.article :global(.card-panel) {
		padding: 1.1rem 1.15rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
	}

	.article :global(h2) {
		margin: 0 0 0.4rem;
		font-family: var(--font-sans);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		font-stretch: normal;
		color: var(--ink);
	}

	.article :global(p) {
		margin: 0;
		font-size: 0.9375rem;
	}

	.article :global(ul) {
		margin: 0.55rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.35rem;
	}

	.article :global(.card-panel li) {
		position: relative;
		padding-left: 0.95rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.article :global(.card-panel li::before) {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--magenta-soft);
	}

	.article :global(a) {
		color: var(--magenta-soft);
		font-weight: 500;
	}

	.article :global(a:hover) {
		color: var(--ink);
	}

	.article :global(.price-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem;
		margin-top: 0.55rem;
	}

	.article :global(.price-card) {
		display: grid;
		gap: 0.2rem;
		justify-items: center;
		padding: 1.2rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-elevated);
		text-align: center;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease;
	}

	.article :global(.price-card:hover) {
		border-color: color-mix(in srgb, var(--magenta) 40%, var(--line));
	}

	.article :global(.price-card.is-featured) {
		border-color: color-mix(in srgb, var(--magenta) 45%, var(--line));
		background: color-mix(in srgb, var(--magenta) 12%, var(--bg-panel));
	}

	.article :global(.price-card__label) {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.article :global(.price-card__price) {
		font-family: var(--font-display);
		font-size: 1.85rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--ink);
	}

	.article :global(.price-card.is-featured .price-card__price) {
		color: var(--magenta-soft);
	}

	.article :global(.price-card__meta) {
		font-size: 0.8rem;
		color: var(--ink-muted);
	}

	.gallery-block {
		width: 100%;
		display: grid;
		gap: 0.85rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 420px;
	}

	.gallery-block__head h2 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		font-stretch: normal;
		color: var(--ink);
	}

	.gallery-block__eyebrow {
		margin: 0 0 0.3rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.gallery-block__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
	}

	.gallery-block__item {
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-elevated);
		aspect-ratio: 16 / 10;
	}

	.gallery-block__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 800px) {
		.article :global(.price-grid) {
			grid-template-columns: 1fr;
		}

		.gallery-block__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 760px) {
		.banner {
			min-height: min(52svh, 22rem);
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
		}

		.banner__shell {
			padding-block: 1.75rem 1.35rem;
			padding-bottom: max(1.35rem, var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
		}

		.banner__scrim {
			background: linear-gradient(
				180deg,
				rgba(8, 9, 10, 0.35) 0%,
				rgba(8, 9, 10, 0.82) 62%,
				rgba(8, 9, 10, 0.96) 100%
			);
		}

		.banner__content {
			width: 100%;
			max-width: 100%;
			min-width: 0;
		}

		.banner__title {
			font-size: clamp(1.55rem, 7.5vw, 2rem);
			overflow-wrap: anywhere;
		}

		.banner__intro {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 3;
			overflow: hidden;
		}

		.banner__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.banner__actions :global(.btn-buy),
		.banner__actions .btn {
			width: 100%;
			min-height: var(--touch-min);
		}

		.article {
			width: 100%;
			min-width: 0;
		}
	}

	@media (max-width: 640px) {
		.gallery-block__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
