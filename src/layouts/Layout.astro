---
import '../styles/global.css';
import fontsCss from '../styles/fonts.css?raw';
import { productInfo, siteConfig } from '../data/site';
import { brandTheme, brandThemeHeadCritical, brandThemeRootCss } from '../data/brand-theme';
import I18nHead from '../components/I18nHead.astro';
import InlineBrandEditor from '../components/InlineBrandEditor.astro';
import { defaultLocale, localeMap, locales, type LocaleCode } from '../data/i18n/locales';
import type { PageId } from '../data/i18n/content.generated';
import { buildCanonicalUrl, type HreflangAlternate } from '../data/i18n/routing';
import { getT } from '../i18n/server';
import { heroWidth, heroHeight, heroMobileSrc, heroDesktopPreloadSrc } from '../lib/responsive-images';
import { lcpPosterCriticalCss } from '../data/lcp-critical-css';
import {
	isBoosterOgImage,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_WIDTH,
	ROBOTS_INDEX,
	siteIdentityGraph,
} from '../data/seo-booster';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	ogImage?: string;
	ogImageAlt?: string;
	noindex?: boolean;
	type?: 'website' | 'article';
	breadcrumbs?: Crumb[];
	locale?: LocaleCode;
	pageId?: PageId;
	hreflangAlternates?: HreflangAlternate[];
	extraGraph?: Record<string, unknown>[];
	lcpImage?: string;
	lcpImageSrcSet?: string;
	lcpImageSizes?: string;
}

const {
	title,
	description,
	canonicalPath = Astro.url.pathname,
	ogImage = siteConfig.defaultOgImage,
	ogImageAlt = title,
	noindex = false,
	type = 'website',
	breadcrumbs,
	locale = defaultLocale,
	pageId,
	hreflangAlternates,
	extraGraph = [],
	lcpImage,
	lcpImageSrcSet,
	lcpImageSizes = '100vw',
} = Astro.props;

const canonicalURL = buildCanonicalUrl(canonicalPath);
const ogImageURL = new URL(ogImage, siteConfig.url).href;
const logoURL = new URL(siteConfig.logoRaster, siteConfig.url).href;
const ogImageIsLogo = ogImage === siteConfig.logo;
const ogImageIsBooster = isBoosterOgImage(ogImage);
const ogImageType = ogImage.endsWith('.webp')
	? 'image/webp'
	: ogImageIsBooster
		? 'image/jpeg'
		: 'image/png';
const ogImageWidth = ogImageIsLogo
	? '512'
	: ogImageIsBooster
		? String(OG_IMAGE_WIDTH)
		: String(heroWidth);
const ogImageHeight = ogImageIsLogo
	? '512'
	: ogImageIsBooster
		? String(OG_IMAGE_HEIGHT)
		: String(heroHeight);
const twitterCard = ogImageIsLogo ? 'summary' : 'summary_large_image';
const robots = noindex ? 'noindex, nofollow' : ROBOTS_INDEX;
const siteDescription = `${productInfo.tagline}. ${productInfo.summary}`;
const localeMeta = localeMap[locale];
const t = getT(locale);
const skipLabel = t('a11y.skipToContent');
const ogLocaleAlternates = locales.filter((l) => l.code !== locale);
const schemaLanguage = localeMeta.ogLocale.replace('_', '-');

const graph: Record<string, unknown>[] = [
	{
		'@type': 'WebPage',
		'@id': `${canonicalURL}#webpage`,
		url: canonicalURL,
		name: title,
		description,
		isPartOf: { '@id': `${siteConfig.url}/#website` },
		inLanguage: schemaLanguage,
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: ogImageURL,
			name: ogImageAlt,
			description: ogImageAlt,
			width: Number(ogImageWidth),
			height: Number(ogImageHeight),
		},
	},
	...siteIdentityGraph({ logoURL, siteDescription }),
];

if (breadcrumbs && breadcrumbs.length > 0) {
	graph.push({
		'@type': 'BreadcrumbList',
		'@id': `${canonicalURL}#breadcrumb`,
		itemListElement: breadcrumbs.map((crumb, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: crumb.label,
			...(crumb.href
				? { item: new URL(crumb.href, siteConfig.url).href }
				: { item: canonicalURL }),
		})),
	});
}

if (extraGraph.length > 0) {
	// Nodes must not carry a nested @context inside @graph (invalid JSON-LD).
	graph.push(
		...extraGraph.map((node) => {
			const { ['@context']: _ignored, ...rest } = node as Record<string, unknown> & {
				'@context'?: unknown;
			};
			return rest;
		}),
	);
}

const softwareNode = extraGraph.find((node) => node['@type'] === 'SoftwareApplication');
const productNode = extraGraph.find((node) => node['@type'] === 'Product');
const aboutNode = softwareNode ?? productNode;
if (aboutNode) {
	const webpage = graph.find((node) => node['@type'] === 'WebPage') as Record<string, unknown> | undefined;
	if (webpage) {
		webpage.about = { '@id': aboutNode['@id'] };
	}
}
---

<!doctype html>
<html lang={locale} dir={localeMeta.dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{
			lcpImage && (
				<>
					<link
						rel="preload"
						as="image"
						href={heroMobileSrc}
						type="image/webp"
						fetchpriority="high"
						media="(max-width: 900px)"
					/>
					<link
						rel="preload"
						as="image"
						href={heroDesktopPreloadSrc}
						type="image/webp"
						fetchpriority="high"
						media="(min-width: 901px)"
					/>
					<link
						rel="preload"
						href="/fonts/inter-latin-wght-normal.woff2"
						as="font"
						type="font/woff2"
						crossorigin
					/>
				</>
			)
		}
		<title>{title}</title>
		<style id="brand-theme-critical" set:html={brandThemeHeadCritical()} />
		<style id="fonts-critical" set:html={fontsCss} />
		{lcpImage && <style id="lcp-poster-critical" set:html={lcpPosterCriticalCss} />}
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content={brandTheme.bg} />
		{/* Self-hosted Inter + Syne (latin) — no Google Fonts. */}
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<meta name="description" content={description} />
		<meta name="author" content={siteConfig.name} />
		<link rel="canonical" href={canonicalURL} />
		{!noindex && <link rel="image_src" href={ogImageURL} />}
		{pageId && <I18nHead pageId={pageId} locale={locale} />}
		{
			!pageId &&
				hreflangAlternates?.map((alt) => (
					<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
				))
		}

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:secure_url" content={ogImageURL} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content={ogImageWidth} />
		<meta property="og:image:height" content={ogImageHeight} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content={localeMeta.ogLocale} />
		{ogLocaleAlternates.map((alt) => (
			<meta property="og:locale:alternate" content={alt.ogLocale} />
		))}

		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
		<link rel="help" href="/llms.txt" title="Site summary for AI crawlers" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{skipLabel}</a>
		<slot />
		<InlineBrandEditor />
		{!noindex && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
			/>
		)}
		{/* After Vite/Tailwind CSS so brand tokens win over @theme defaults */}
		<style id="brand-theme-vars" set:html={brandThemeRootCss()}></style>
		<script is:inline>
			{`(()=>{if(!window.trustedTypes||!window.trustedTypes.createPolicy)return;try{window.trustedTypes.createPolicy('default',{createHTML:i=>i,createScript:i=>i,createScriptURL:i=>i})}catch{}})();`}
		</script>
		<link rel="manifest" href="/site.webmanifest" />
		<script is:inline src="/site-ui.js" defer></script>
	</body>
</html>
