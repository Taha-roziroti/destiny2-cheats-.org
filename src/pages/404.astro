---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSelfHreflangAlternates, getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, isLocaleCode, type LocaleCode } from '../data/i18n/locales';
import { fillBrandTokens, productInfo, siteConfig } from '../data/site';
import { sitePaths } from '../data/site-paths';
import { getT } from '../i18n/server';

const segment = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const locale: LocaleCode = isLocaleCode(segment) ? segment : defaultLocale;
const t = getT(locale);

const title = fillBrandTokens('Page Not Found | {brand}');
const description = fillBrandTokens(
	'That {brand} page is missing. Return home or browse features, store, setup, reviews, and forums.',
);
const canonicalPath = Astro.url.pathname;
const hreflangAlternates = getSelfHreflangAlternates(canonicalPath);
const homeHref = getLocalizedPath('home', locale);
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	hreflangAlternates={hreflangAlternates}
	locale={locale}
	noindex={true}
>
	<Navbar locale={locale} />
	<main id="main-content" class="missing">
		<div class="shell">
			<div class="shell-content missing__inner">
				<p class="missing__code" aria-hidden="true">404</p>
				<h1 class="missing__title">{t('a11y.notFoundTitle')}</h1>
				<p class="missing__text">{t('a11y.notFoundText')}</p>
				<div class="missing__actions">
					<a class="btn-buy" href={homeHref}>{t('a11y.notFoundBackHome')}</a>
					<a class="missing__ghost" href={getLocalizedPath('hacks', locale)}>{t('nav.preview')}</a>
					<a class="missing__ghost" href={getLocalizedPath('pricing', locale)}>{t('nav.store')}</a>
					<a class="missing__ghost" href={sitePaths.reviews}>{t('nav.reviews')}</a>
					<a class="missing__ghost" href={sitePaths.forums}>{t('nav.forums')}</a>
					<a class="missing__ghost" href={getLocalizedPath('support', locale)}>{t('common.support')}</a>
				</div>
			</div>
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.missing {
		min-height: 58vh;
		display: grid;
		align-items: center;
		padding-block: clamp(2.5rem, 8vw, 5rem);
	}

	.missing__inner {
		display: grid;
		gap: 0.85rem;
	}

	.missing__code {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 800;
		letter-spacing: 0.04em;
		color: color-mix(in srgb, var(--magenta-soft) 55%, transparent);
		line-height: 1;
	}

	.missing__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		font-weight: 800;
		color: var(--ink);
	}

	.missing__text {
		margin: 0;
		color: var(--ink-muted);
		line-height: 1.65;
		max-width: 36rem;
	}

	.missing__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.75rem;
	}

	.missing__ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: var(--touch-min);
		padding: 0.55rem 0.95rem;
		border-radius: 0.7rem;
		border: 1px solid var(--line-strong);
		background: var(--bg-elevated);
		color: var(--ink);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.missing__ghost:hover {
		border-color: color-mix(in srgb, var(--magenta) 40%, var(--line-strong));
		color: var(--magenta-soft);
	}

	@media (max-width: 720px) {
		.missing__actions {
			flex-direction: column;
		}

		.missing__ghost,
		.missing__actions :global(.btn-buy) {
			width: 100%;
		}
	}
</style>
