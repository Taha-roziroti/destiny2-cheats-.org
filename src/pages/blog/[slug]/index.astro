---
import { blogToForumRedirects } from '../../../data/forums/helpers';

export function getStaticPaths() {
	return Object.keys(blogToForumRedirects).map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const target = blogToForumRedirects[slug];
return Astro.redirect(target ? `/forums/${target}/` : '/forums/', 301);
---
