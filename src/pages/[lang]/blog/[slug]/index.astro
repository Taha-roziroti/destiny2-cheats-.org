---
import { blogToForumRedirects } from '../../../../data/forums/helpers';
import { defaultLocale, isLocaleCode, localeCodes, type LocaleCode } from '../../../../data/i18n/locales';
import { findPostBySlug } from '../../../../data/blog/helpers';

export function getStaticPaths() {
	const paths: { params: { lang: string; slug: string }; props: { locale: LocaleCode } }[] = [];
	for (const locale of localeCodes) {
		if (locale === defaultLocale) continue;
		for (const slug of Object.keys(blogToForumRedirects)) {
			paths.push({ params: { lang: locale, slug }, props: { locale } });
		}
	}
	return paths;
}

const slug = Astro.params.slug ?? '';
if (!isLocaleCode(Astro.params.lang ?? '')) {
	return Astro.redirect('/forums/', 301);
}

const post = findPostBySlug(slug);
const enSlug = post?.translations[defaultLocale]?.slug ?? slug;
const target = blogToForumRedirects[enSlug];
return Astro.redirect(target ? `/forums/${target}/` : '/forums/', 301);
---
