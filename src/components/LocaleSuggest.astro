---
import { locales, defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { localizedSlugs, type PageId } from '../data/i18n/routing';
import { getT } from '../i18n/server';

interface Props {
	currentLocale: LocaleCode;
	pageId?: PageId;
}

const { currentLocale, pageId = 'home' } = Astro.props;

if (currentLocale !== defaultLocale) {
	return null;
}

const t = getT(currentLocale);
const localeMetas = locales.map((l) => ({
	code: l.code,
	name: l.name,
	nativeName: l.nativeName,
	region: l.region,
}));
const pageSlugs = localizedSlugs[pageId] ?? {};
const strings = {
	regionAria: t('common.languageSuggestion'),
	dismiss: t('common.dismiss'),
	lead: t('common.localeSuggestLead', { nativeName: '{{nativeName}}', region: '{{region}}' }),
	version: t('common.localeVersion', { name: '{{name}}' }),
};
---

<div
	id="locale-suggest-mount"
	hidden
	data-current-locale={currentLocale}
	data-default-locale={defaultLocale}
	data-locales={JSON.stringify(localeMetas)}
	data-page-slugs={JSON.stringify(pageSlugs)}
	data-strings={JSON.stringify(strings)}
></div>
<script is:inline>
	{`(function(){function l(){var s=document.createElement('script');s.src='/locale-suggest.js';s.defer=true;document.body.appendChild(s)}if('requestIdleCallback'in window)requestIdleCallback(l,{timeout:2500});else window.addEventListener('load',l,{once:true})})();`}
</script>
<style is:global>
	.locale-suggest {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 0.55rem 1rem;
		background: color-mix(in srgb, var(--magenta) 14%, var(--bg));
		border-bottom: 1px solid color-mix(in srgb, var(--magenta) 25%, var(--line));
		font-size: 0.82rem;
		color: var(--ink-muted);
		text-align: center;
	}

	.locale-suggest__text {
		margin: 0;
	}

	.locale-suggest a {
		color: var(--magenta-soft);
		font-weight: 700;
		text-decoration: underline;
	}

	.locale-suggest__dismiss {
		border: none;
		background: transparent;
		color: var(--ink-faint);
		font-size: 1.2rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.15rem 0.35rem;
	}
</style>
