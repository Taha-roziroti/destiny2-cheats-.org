---
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getLocalizedPath } from '../data/i18n/routing';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const pricingHref = getLocalizedPath('pricing', locale);
const updatesHref = getLocalizedPath('updates', locale);

const features = [
	{ key: 'home.featEsp', icon: '◉' },
	{ key: 'home.featAim', icon: '◎' },
	{ key: 'home.featRadar', icon: '◈' },
	{ key: 'home.featStream', icon: '◌' },
] as const;
---

<section class="home-about shell" aria-labelledby="home-about-title">
	<header class="home-about__head">
		<h2 id="home-about-title" class="home-about__section-title">{t('home.aboutEyebrow')}</h2>
		<p class="home-about__section-sub">{t('home.aboutTitle')}</p>
		<p class="home-about__lede">{t('home.aboutLede')}</p>
	</header>
	<ul class="home-about__features" aria-label={t('home.featuresAria')}>
		{
			features.map((item) => (
				<li>
					<span class="home-about__feat-icon" aria-hidden="true">{item.icon}</span>
					<span>{t(item.key)}</span>
				</li>
			))
		}
	</ul>
	<div class="home-about__actions">
		<a class="home-about__cta" href={pricingHref}>{t('home.ctaPlans')}</a>
		<a class="home-about__cta home-about__cta--ghost" href={updatesHref}>{t('home.ctaStatus')}</a>
	</div>
</section>

<style is:global>
	.home-about {
		padding-block: clamp(2.5rem, 5vw, 3.25rem) clamp(1.5rem, 3vw, 2rem);
		border-bottom: 1px solid var(--line-soft);
		text-align: center;
	}

	.home-about__head {
		max-width: 42rem;
		margin-inline: auto;
		margin-bottom: 1.5rem;
	}

	.home-about__section-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.4vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--ink);
	}

	.home-about__section-sub {
		margin: 0.4rem 0 0;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--ink-muted);
	}

	.home-about__lede {
		margin: 0.65rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.home-about__features {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 0 1.35rem;
		padding: 0;
		list-style: none;
	}

	.home-about__features li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg-panel);
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--ink-muted);
	}

	.home-about__feat-icon {
		font-size: 0.65rem;
		line-height: 1;
		color: var(--accent);
		opacity: 0.85;
	}

	.home-about__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		margin-bottom: 1.5rem;
	}

	.home-about__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0 1.15rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		background: var(--accent);
		color: #fafbfd;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.home-about__cta:hover {
		background: var(--accent-hover);
		color: #fafbfd;
		transform: translateY(-1px);
	}

	.home-about__cta--ghost {
		background: transparent;
		color: var(--ink);
		border: 1px solid var(--line);
	}

	.home-about__cta--ghost:hover {
		background: var(--bg-elevated);
		border-color: var(--line-strong);
		color: var(--ink);
		transform: none;
	}

	@media (max-width: 480px) {
		.home-about__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.home-about__cta {
			width: 100%;
		}
	}
</style>
