---
import HeroApp from './react/Hero';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { getPageContent } from '../data/i18n';
import { productInfo, siteConfig } from '../data/site';
import { heroWidth, heroHeight, heroSrcSet, heroSizes, heroSrc } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const home = getPageContent(locale, 'home');
const heroVideo = siteConfig.heroVideo?.trim() || '';
const heroLabel = locale === 'en' ? siteConfig.name : home.h1;
const imageAlt = home.imageAlt;
---

<section class="hero" aria-label={heroLabel}>
	<div class="hero__media">
		{
			heroVideo ? (
				<video
					class="hero__video"
					src={heroVideo}
					poster={siteConfig.heroVideoPoster || siteConfig.heroImage}
					autoplay
					muted
					loop
					playsinline
					preload="auto"
					width={heroWidth}
					height={heroHeight}
					aria-hidden="true"
				>
				</video>
			) : (
				<img
					src={heroSrc}
					srcset={heroSrcSet}
					sizes={heroSizes}
					alt={imageAlt}
					width={heroWidth}
					height={heroHeight}
					fetchpriority="high"
					loading="eager"
					decoding="async"
				/>
			)
		}
	</div>
	<div class="hero__veil" aria-hidden="true"></div>
	<HeroApp
		client:load
		locale={locale}
		siteName={siteConfig.name}
		checkoutUrl={siteConfig.checkoutUrl}
		monthlyPrice={monthly.price}
		useBrandHero={false}
	/>
</section>

{
	heroVideo ? (
		<script is:inline>
			(() => {
				const video = document.querySelector('.hero__video');
				if (!(video instanceof HTMLVideoElement)) return;

				video.muted = true;
				video.defaultMuted = true;
				video.playsInline = true;

				const play = () => {
					const attempt = video.play();
					if (attempt && typeof attempt.catch === 'function') {
						attempt.catch(() => {});
					}
				};

				video.addEventListener('loadeddata', play);
				video.addEventListener('canplay', play);
				video.addEventListener('canplaythrough', play);

				play();
				let tries = 0;
				const retry = window.setInterval(() => {
					if (video.paused && tries < 12) {
						play();
						tries += 1;
						return;
					}
					window.clearInterval(retry);
				}, 400);
			})();
		</script>
	) : null
}

<style is:global>
	.hero {
		--hero-pad-y: clamp(1rem, 2vw, 1.75rem);
		--hero-stack: clamp(0.85rem, 1.5vw, 1.15rem);
		/*
		 * Bar is a bit shorter than the native 1024/409 (~2.5:1) art.
		 * Image stays undistorted via object-fit: cover (crops edges, no squash).
		 */
		--hero-ratio: 3.15 / 1;
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		overflow: hidden;
		background: #0D0A14;
		aspect-ratio: var(--hero-ratio);
		width: 100%;
		height: auto;
		min-height: 0;
		max-height: none;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media picture,
	.hero__media img,
	.hero__media video {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__media img,
	.hero__media video {
		/* Cover = keep proportions; crop top/bottom of the shorter bar */
		object-fit: cover;
		/* Prefer a bit higher in the frame so the Guardian silhouette stays in view */
		object-position: right 28%;
		image-rendering: auto;
		transform: translateZ(0);
		animation: hero-in 0.9s ease-out both;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(5, 5, 6, 0.78) 0%,
			rgba(5, 5, 6, 0.52) 34%,
			rgba(5, 5, 6, 0.18) 58%,
			transparent 74%
		);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		padding-block: var(--hero-pad-y);
		align-self: center;
		/* Sit a touch above true center so title reads mid-image */
		transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: start;
		box-sizing: border-box;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--hero-stack);
		width: min(100%, 32rem);
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		animation: rise 0.65s ease-out both;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(1.85rem, 3.8vw, 2.85rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: #fff;
		width: 100%;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.hero__lede {
		margin: 0;
		width: 100%;
		max-width: none;
		font-size: clamp(0.95rem, 1.5vw, 1.05rem);
		line-height: 1.55;
		color: color-mix(in srgb, #fff 74%, var(--ink-muted));
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		margin: 0;
		width: 100%;
	}

	.hero__buy {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.55rem;
		width: auto;
		max-width: 100%;
		min-height: 3rem;
		padding: 0.55rem 0.55rem 0.55rem 1.05rem;
		border-radius: 999px;
		background: var(--accent);
		color: #FAFBFD;
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		box-shadow:
			0 1px 0 color-mix(in srgb, #FAFBFD 25%, transparent) inset,
			0 10px 28px color-mix(in srgb, var(--accent) 35%, transparent);
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			box-shadow 0.18s ease;
	}

	.hero__buy svg {
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		opacity: 0.85;
	}

	.hero__buy-label {
		padding-right: 0.15rem;
	}

	.hero__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		margin-left: auto;
		padding: 0 0.85rem;
		border-radius: 999px;
		background: var(--magenta-deep);
		color: #FAFBFD;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.hero__buy:hover {
		background: var(--accent-hover);
		color: #FAFBFD;
		transform: translateY(-2px);
		box-shadow:
			0 1px 0 color-mix(in srgb, #FAFBFD 25%, transparent) inset,
			0 14px 32px color-mix(in srgb, var(--accent) 42%, transparent);
	}

	.hero__buy:hover .hero__buy-price {
		background: color-mix(in srgb, var(--magenta-deep) 85%, #000 15%);
	}

	.hero__buy:active {
		transform: translateY(0);
	}

	.hero__features {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1rem;
		row-gap: 0.55rem;
		margin: 0.35rem 0 0;
		padding: 0;
		list-style: none;
		width: 100%;
		max-width: none;
	}

	.hero__features li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
		color: color-mix(in srgb, #fff 72%, transparent);
	}

	.hero__features li span {
		min-width: 0;
	}

	.hero__features svg {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-in {
		from {
			opacity: 0.7;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__media img,
		.hero__media video {
			animation: none;
		}

		.hero__buy,
		.hero__buy:hover {
			transition: none;
			transform: none;
		}

		.hero__content {
			transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		}
	}

	/*
	 * Phones / small tablets: stop using the ultra-wide 3.15:1 bar.
	 * That ratio collapses to ~120px tall on a 390px phone and clips the CTA.
	 * Mobile = taller full-bleed panel; height grows with copy.
	 */
	@media (max-width: 900px) {
		.hero {
			aspect-ratio: auto;
			min-height: 0;
			max-height: none;
			height: auto;
			display: block;
			overflow: hidden;
		}

		.hero__media img,
		.hero__media video {
			object-fit: cover;
			object-position: 78% 10%;
		}

		.hero__veil {
			background: linear-gradient(
				180deg,
				rgba(5, 5, 6, 0.28) 0%,
				rgba(5, 5, 6, 0.52) 42%,
				rgba(5, 5, 6, 0.9) 78%,
				rgba(5, 5, 6, 0.96) 100%
			);
		}

		.hero__content {
			transform: none;
			width: 100%;
			min-height: clamp(18.5rem, 56svh, 28rem);
			display: flex;
			align-items: flex-end;
			padding-block: 1.35rem 1.2rem;
			padding-bottom: max(1.2rem, env(safe-area-inset-bottom, 0px));
			box-sizing: border-box;
		}

		.hero__copy {
			width: 100%;
			max-width: 28rem;
			gap: clamp(0.7rem, 2vw, 0.95rem);
		}

		.hero__brand {
			font-size: clamp(1.55rem, 6.8vw, 2.1rem);
			line-height: 1.08;
			white-space: normal;
		}

		.hero__lede {
			display: block;
			overflow: visible;
			-webkit-line-clamp: unset;
			font-size: clamp(0.9rem, 3.6vw, 1rem);
			max-width: 34ch;
			color: color-mix(in srgb, #fff 80%, var(--ink-muted));
		}

		.hero__actions {
			width: 100%;
		}

		.hero__buy {
			width: 100%;
			max-width: 22rem;
			min-height: var(--touch-min, 2.75rem);
			font-size: 0.9375rem;
			justify-content: flex-start;
		}

		.hero__buy-price {
			margin-left: auto;
		}

		.hero__features {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 0.75rem;
			row-gap: 0.45rem;
			max-width: 22rem;
		}

		.hero__features li {
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.hero__content {
			min-height: clamp(17.5rem, 60svh, 26rem);
			padding-block: 1.2rem 1.1rem;
		}

		.hero__brand {
			font-size: clamp(1.55rem, 8.2vw, 1.95rem);
		}

		.hero__lede {
			max-width: none;
		}

		.hero__buy {
			width: 100%;
			max-width: none;
		}

		.hero__features {
			max-width: none;
		}
	}

	@media (max-width: 360px) {
		.hero__content {
			min-height: clamp(16.5rem, 64svh, 24rem);
		}

		.hero__brand {
			font-size: 1.45rem;
		}

		.hero__features {
			grid-template-columns: 1fr;
			row-gap: 0.35rem;
		}
	}

	@media (max-width: 900px) and (orientation: landscape) and (max-height: 480px) {
		.hero__content {
			min-height: min(70svh, 16.5rem);
			padding-block: 0.85rem 0.8rem;
		}

		.hero__lede {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			overflow: hidden;
			font-size: 0.85rem;
		}

		.hero__features {
			display: none;
		}

		.hero__buy {
			max-width: 20rem;
		}
	}
</style>
