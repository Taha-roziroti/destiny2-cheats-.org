---
import NavbarApp from './react/Navbar';
import {
	getLocalizedPath,
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, locales, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getBlogLocaleSwitchHref, isBlogPath } from '../data/blog/helpers';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const onBlog = isBlogPath(current);

const pageContext = onBlog
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageId,
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) return getBlogLocaleSwitchHref(current, targetLocale);
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const hrefForLocale = Object.fromEntries(
	locales.map((l) => [l.code, localeSwitchHref(l.code)]),
) as Record<string, string>;

const localeMetas = locales.map((l) => ({
	code: l.code,
	name: l.name,
	nativeName: l.nativeName,
	hreflang: l.hreflang,
	region: l.region,
}));

const links = [
	{ id: 'home', labelKey: 'nav.home', href: getLocalizedPath('home', locale) },
	{ id: 'hacks', labelKey: 'nav.preview', edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{ id: 'esp', labelKey: 'nav.esp', href: getLocalizedPath('destiny-2-esp', locale) },
	{ id: 'aimbot', labelKey: 'nav.aimbot', href: getLocalizedPath('destiny-2-aimbot', locale) },
	{ id: 'pricing', labelKey: 'nav.store', edit: 'navStore', href: getLocalizedPath('pricing', locale) },
	{ id: 'updates', labelKey: 'nav.status', edit: 'navStatus', href: getLocalizedPath('updates', locale) },
	{ id: 'forums', labelKey: 'nav.forums', href: '/forums/' },
	{ id: 'reviews', labelKey: 'nav.reviews', edit: 'navReviews', href: reviewsBasePath },
];
---

<NavbarApp
	client:load
	locale={locale}
	siteName={siteConfig.name}
	checkoutUrl={siteConfig.checkoutUrl}
	currentPath={current}
	homeHref={getLocalizedPath('home', locale)}
	reviewsBasePath={reviewsBasePath}
	locales={localeMetas}
	hrefForLocale={hrefForLocale}
	links={links}
/>

<style is:global>
	.lang-switcher {
		position: relative;
	}

	.lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.15rem;
		padding: 0 0.85rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg-panel);
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		list-style: none;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.lang-switcher__toggle::-webkit-details-marker {
		display: none;
	}

	.lang-switcher__toggle:hover {
		border-color: var(--line-strong);
		background: var(--bg-elevated);
	}

	.lang-switcher__toggle svg {
		width: 0.9rem;
		height: 0.9rem;
		flex-shrink: 0;
		color: var(--accent);
		opacity: 0.9;
	}

	.lang-switcher__panel {
		position: absolute;
		left: 0;
		top: calc(100% + 0.45rem);
		z-index: 120;
		width: min(16.5rem, calc(100vw - 2rem));
		max-height: min(20rem, 60vh);
		overflow: auto;
		padding: 0.5rem;
		background: var(--bg-panel);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 12px 32px color-mix(in srgb, var(--ink) 12%, transparent);
	}

	.site-tools .lang-switcher__panel {
		left: auto;
		right: 0;
	}

	.lang-switcher__note {
		margin: 0 0 0.45rem;
		padding: 0.45rem 0.55rem;
		border-radius: var(--radius-sm);
		background: var(--bg-elevated);
		color: var(--ink-faint);
		font-size: 0.6875rem;
		line-height: 1.4;
	}

	.lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.2rem;
	}

	.lang-switcher__link {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		border-radius: var(--radius-sm);
		color: var(--ink);
		text-decoration: none;
		transition: background 0.15s ease;
	}

	.lang-switcher__link:hover,
	.lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--accent) 8%, var(--bg-elevated));
	}

	.lang-switcher__link.is-current {
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);
	}

	.lang-switcher__native {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.lang-switcher__region {
		display: block;
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1.2;
		color: var(--ink-faint);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.site-header.is-scrolled {
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		border-bottom-color: var(--line-soft);
		box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 8%, transparent);
	}

	.site-header__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: var(--header-h);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-evenly;
		gap: 0;
		width: min(calc(100% - 11.5rem), 38rem);
		max-width: 100%;
		min-width: 0;
		padding: 0.28rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: var(--bg-panel);
		box-shadow: 0 1px 2px color-mix(in srgb, var(--ink) 4%, transparent);
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
		-webkit-overflow-scrolling: touch;
	}

	.site-nav::-webkit-scrollbar {
		display: none;
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 1 1 0;
		min-width: 0;
		padding: 0.48rem 0.65rem;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		text-align: center;
		color: var(--ink-muted);
		white-space: nowrap;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.site-nav a:hover {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 6%, transparent);
	}

	.site-nav a.is-active {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);
	}

	.site-tools {
		position: absolute;
		top: 50%;
		right: 0;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
		flex-shrink: 0;
		z-index: 2;
	}

	.site-tools__lang {
		flex-shrink: 0;
	}

	.site-tools__lang .lang-switcher__toggle span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 5.5rem;
	}

	.site-tools__buy {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.15rem;
		height: auto;
		padding: 0 1rem;
		border-radius: 999px;
		background: var(--accent);
		color: #FAFBFD;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.site-tools__buy svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	.site-tools__buy:hover {
		background: var(--accent-hover);
		color: #FAFBFD;
		transform: translateY(-1px);
	}

	@media (max-width: 1024px) {
		.site-header__bar {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: 0.5rem;
		}

		.site-nav {
			position: static;
			width: auto;
			max-width: none;
			justify-content: space-between;
			padding: 0.22rem 0.28rem;
			border-radius: var(--radius-md);
		}

		.site-tools {
			position: static;
			transform: none;
		}

		.site-nav a {
			flex: 1 1 0;
			min-width: 0;
			padding: 0.42rem 0.35rem;
			font-size: 0.76rem;
		}

		.site-tools__lang .lang-switcher__toggle,
		.site-tools__buy {
			min-height: var(--touch-min, 2.75rem);
		}

		.site-tools__buy {
			padding-inline: 0.85rem;
			font-size: 0.8rem;
		}
	}

	@media (max-width: 480px) {
		.site-header__bar {
			gap: 0.4rem;
		}

		.site-nav a {
			padding: 0.38rem 0.25rem;
			font-size: 0.72rem;
		}

		.site-tools {
			gap: 0.35rem;
		}

		.site-tools__lang .lang-switcher__toggle {
			padding-inline: 0.65rem;
		}

		.site-tools__lang .lang-switcher__toggle span {
			max-width: 4.25rem;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
		}
	}

	@media (max-width: 360px) {
		.site-tools__lang .lang-switcher__toggle span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.site-tools__lang .lang-switcher__toggle {
			width: var(--touch-min, 2.75rem);
			justify-content: center;
			padding-inline: 0;
		}

		.site-tools__buy span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
			min-width: var(--touch-min);
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-nav a,
		.site-tools__buy {
			transition: none;
		}

		.site-tools__buy:hover {
			transform: none;
		}
	}
</style>
