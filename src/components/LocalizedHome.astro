---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomeSeo from '../components/HomeSeo.astro';
import HomeAbout from '../components/HomeAbout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeSeo, siteConfig } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo();

const title = locale === 'en' ? enHome.title : home.title;
const description = locale === 'en' ? enHome.description : home.description;
const canonicalPath = getLocalizedPath('home', locale);
const heroVideo = siteConfig.heroVideo?.trim() || '';
/** Product schema lives on /d2-cheats/ only — home stays a brand landing without duplicate Product markup. */
const extraGraph: Record<string, unknown>[] = [];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={
		home.imageAlt?.trim() && home.imageAlt.trim().length > 12
			? home.imageAlt
			: `${siteConfig.name} — Destiny 2 ESP and aimbot`
	}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={extraGraph}
	lcpImage={heroVideo ? undefined : heroPreloadSrc}
	lcpImageSrcSet={heroVideo ? undefined : heroSrcSet}
	lcpImageSizes={heroVideo ? undefined : heroSizes}
	lcpVideo={heroVideo || undefined}
>
	<Navbar locale={locale} pageId="home" />
	<main id="main-content" class="home">
		<Hero locale={locale} />
		<HomeReviews locale={locale} />
		<div class="home__seo">
			<>
				<HomeAbout locale={locale} />
				<div class="shell home__prose">
					<header class="home__prose-head">
						<p class="home__prose-eyebrow">{ui.nav.hacks}</p>
						<h2>{home.h1}</h2>
						<p class="home__prose-lede">{home.intro}</p>
					</header>
					{
						home.sections.map((section) => (
							<article class="home__prose-block">
								<h3>{section.h2}</h3>
								{section.paragraphs.map((p) => (
									<p set:html={p} />
								))}
								{
									section.list?.length ? (
										<ul>
											{section.list.map((item) => (
												<li set:html={item} />
											))}
										</ul>
									) : null
								}
							</article>
						))
					}
				</div>
				<HomeSeo locale={locale} />
			</>
		</div>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.home {
		width: 100%;
		overflow-x: clip;
	}

	.home__seo {
		border-top: 1px solid var(--line-soft);
		background: var(--bg-panel);
		content-visibility: auto;
		contain-intrinsic-size: 1px 900px;
	}

	.home__prose {
		padding-block: clamp(2.5rem, 5vw, 3.5rem);
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
		max-width: var(--content-max);
	}

	.home__prose-head {
		margin-bottom: 1.75rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home__prose-eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.home__prose-lede {
		margin: 0.5rem 0 0;
		max-width: 38rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.home__prose-block {
		margin-top: 1.5rem;
	}

	.home__prose-block + .home__prose-block {
		padding-top: 1.5rem;
		border-top: 1px solid var(--line-soft);
	}

	.home__prose a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose a:hover {
		color: var(--ink);
	}

	.home__prose h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.2vw, 1.5rem);
		letter-spacing: -0.03em;
		line-height: 1.2;
		color: var(--ink);
	}

	.home__prose h3 {
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 700;
		color: var(--ink);
	}

	.home__prose p {
		margin: 0 0 0.75rem;
	}

	.home__prose ul {
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.35rem;
	}

	.home__prose li {
		position: relative;
		padding-left: 1rem;
		font-size: 0.875rem;
		color: var(--ink-muted);
	}

	.home__prose li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--magenta-soft);
	}
</style>
