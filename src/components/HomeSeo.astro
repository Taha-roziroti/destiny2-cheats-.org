---
import { homeFaqs } from '../data/site';
import { getFaqPath } from '../data/faq';
import { forumsBasePath } from '../data/forums/helpers';
import { reviewsBasePath } from '../data/reviews';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getLocalizedPath } from '../data/i18n/routing';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const faqs = homeFaqs.map((item) => ({
	slug: item.slug,
	question: item.question,
	answer: item.answer,
	href: getFaqPath(item.slug),
}));

const p = {
	features: getLocalizedPath('features', locale),
	pricing: getLocalizedPath('pricing', locale),
	setup: getLocalizedPath('setup', locale),
	updates: getLocalizedPath('updates', locale),
	faq: getLocalizedPath('faq', locale),
	support: getLocalizedPath('support', locale),
	cheats: getLocalizedPath('hacks', locale),
	esp: getLocalizedPath('destiny-2-esp', locale),
	aimbot: getLocalizedPath('destiny-2-aimbot', locale),
	radar: getLocalizedPath('radar', locale),
	reviews: reviewsBasePath,
	forums: forumsBasePath,
};

const rawCategories = [
	{
		titleKey: 'homeSeo.catFeatures',
		hintKey: 'homeSeo.catFeaturesHint',
		links: [
			{ href: p.features, labelKey: 'homeSeo.linkAllFeatures' },
			{ href: p.esp, labelKey: 'homeSeo.linkEsp' },
			{ href: p.aimbot, labelKey: 'homeSeo.linkAimbot' },
			{ href: p.radar, labelKey: 'homeSeo.linkRadar' },
		],
	},
	{
		titleKey: 'homeSeo.catStatus',
		hintKey: 'homeSeo.catStatusHint',
		links: [
			{ href: p.updates, labelKey: 'homeSeo.linkLiveStatus' },
			{ href: p.cheats, labelKey: 'homeSeo.linkCheats' },
			{ href: p.setup, labelKey: 'homeSeo.linkSetup' },
			{ href: p.faq, labelKey: 'homeSeo.linkFaq' },
		],
	},
	{
		titleKey: 'homeSeo.catStore',
		hintKey: 'homeSeo.catStoreHint',
		links: [
			{ href: p.pricing, labelKey: 'homeSeo.linkPlans' },
			{ href: p.reviews, labelKey: 'homeSeo.linkReviews' },
			{ href: p.cheats, labelKey: 'homeSeo.linkDestiny2Cheats' },
		],
	},
	{
		titleKey: 'homeSeo.catHelp',
		hintKey: 'homeSeo.catHelpHint',
		links: [
			{ href: p.support, labelKey: 'homeSeo.linkSupport' },
			{ href: p.setup, labelKey: 'homeSeo.linkSetupGuide' },
			{ href: p.forums, labelKey: 'homeSeo.linkForums' },
		],
	},
];

const seenHref = new Set<string>();
const seenLabel = new Set<string>();
const categories = rawCategories.map((cat) => ({
	...cat,
	links: cat.links.filter((link) => {
		const label = t(link.labelKey).trim().toLowerCase();
		if (seenHref.has(link.href) || seenLabel.has(label)) return false;
		seenHref.add(link.href);
		seenLabel.add(label);
		return true;
	}),
}));
---

<section class="home-seo shell" aria-labelledby="home-seo-title">
	<header class="home-seo__head">
		<div>
			<h2 id="home-seo-title" class="home-seo__section-title">{t('homeSeo.eyebrow')}</h2>
			<p class="home-seo__section-sub">{t('homeSeo.title')}</p>
			<p class="home-seo__lede">{t('homeSeo.lede')}</p>
		</div>
	</header>

	<div class="home-seo__cats">
		{
			categories.map((cat) => (
				<nav class="home-seo__cat" aria-label={t(cat.titleKey)}>
					<header class="home-seo__cat-head">
						<h3>{t(cat.titleKey)}</h3>
						<p>{t(cat.hintKey)}</p>
					</header>
					<ul>
						{
							cat.links.map((link) => (
								<li>
									<a href={link.href}>
										<span>{t(link.labelKey)}</span>
										<span class="home-seo__cat-arrow" aria-hidden="true" />
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			))
		}
	</div>

	<section class="home-seo__faq" aria-labelledby="home-faq-title">
		<header class="home-seo__faq-head">
			<div>
				<h3 id="home-faq-title" class="home-seo__section-title">{t('homeSeo.faqEyebrow')}</h3>
				<p class="home-seo__section-sub">{t('homeSeo.faqTitle')}</p>
				<p class="home-seo__faq-lede">{t('homeSeo.faqLede')}</p>
			</div>
			<a class="home-seo__faq-link" href={p.faq}>{t('homeSeo.allAnswers')}</a>
		</header>
		<div class="home-seo__faq-list">
			{
				faqs.map((item) => (
					<details class="home-seo__item" id={item.slug}>
						<summary>
							<span>{item.question}</span>
							<span class="home-seo__chev" aria-hidden="true" />
						</summary>
						<div class="home-seo__item-body">
							<p>{item.answer}</p>
							<a class="home-seo__item-link" href={item.href}>{item.question}</a>
						</div>
					</details>
				))
			}
		</div>
	</section>
</section>

<style is:global>
	.home-seo {
		padding-block: clamp(2.75rem, 5vw, 4rem);
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.home-seo__head {
		margin-bottom: 1.35rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--line-soft);
		text-align: center;
	}

	.home-seo__head > div {
		max-width: 40rem;
		margin-inline: auto;
	}

	.home-seo__section-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.4vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--ink);
	}

	.home-seo__section-sub {
		margin: 0.4rem 0 0;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--ink-muted);
	}

	.home-seo__lede {
		margin: 0.45rem auto 0;
		max-width: 36rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.home-seo__cats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.85rem;
		align-items: stretch;
		width: 100%;
	}

	.home-seo__cat {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.home-seo__cat:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-seo__cat-head {
		padding: 1rem 0.85rem 0.85rem;
		border-bottom: 1px solid var(--line-soft);
		background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
		text-align: center;
	}

	.home-seo__cat-head h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.home-seo__cat-head p {
		margin: 0.35rem 0 0;
		font-size: 0.75rem;
		line-height: 1.35;
		color: var(--ink-faint);
	}

	.home-seo__cat ul {
		margin: 0;
		padding: 0.25rem 0;
		list-style: none;
		display: grid;
		flex: 1;
	}

	.home-seo__cat a {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.7rem 0.85rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.home-seo__cat-arrow {
		display: none;
	}

	.home-seo__cat a:hover {
		background: color-mix(in srgb, var(--accent) 8%, transparent);
		color: var(--accent);
	}

	.home-seo__faq {
		margin-top: 2.25rem;
		margin-inline: auto;
		width: 100%;
		max-width: 40rem;
		padding: clamp(1.35rem, 3vw, 1.85rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 70% 80% at 100% 0%, color-mix(in srgb, var(--magenta) 10%, transparent), transparent 50%),
			var(--bg-panel);
	}

	.home-seo__faq-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		margin-bottom: 1.15rem;
		padding-bottom: 1.05rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-seo__faq-head > div {
		max-width: 36rem;
	}


	.home-seo__faq-lede {
		margin: 0.45rem 0 0;
		max-width: 36rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.home-seo__faq-link {
		flex-shrink: 0;
		margin-top: 0;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
		white-space: nowrap;
	}

	.home-seo__faq-link:hover {
		color: var(--ink);
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.45rem;
	}

	.home-seo__item {
		margin: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: color-mix(in srgb, var(--bg) 55%, var(--bg-elevated));
		overflow: hidden;
	}

	.home-seo__item[open],
	.home-seo__item:hover {
		border-color: color-mix(in srgb, var(--magenta) 28%, var(--line));
	}

	.home-seo__item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		list-style: none;
		padding: 0.95rem 1.05rem;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--ink);
		text-align: left;
	}

	.home-seo__item summary > span:first-child {
		flex: 1;
		min-width: 0;
	}

	.home-seo__item summary::-webkit-details-marker {
		display: none;
	}

	.home-seo__item[open] summary {
		border-bottom: 1px solid var(--line-soft);
		color: var(--magenta-soft);
	}

	.home-seo__chev {
		position: relative;
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
	}

	.home-seo__chev::before,
	.home-seo__chev::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		background: var(--magenta-soft);
		border-radius: 999px;
	}

	.home-seo__chev::before {
		width: 0.45rem;
		height: 1.5px;
		transform: translate(-50%, -50%);
	}

	.home-seo__chev::after {
		width: 1.5px;
		height: 0.45rem;
		transform: translate(-50%, -50%);
	}

	.home-seo__item[open] .home-seo__chev::after {
		opacity: 0;
	}

	.home-seo__item-body {
		display: grid;
		gap: 0.65rem;
		padding: 0.85rem 1.05rem 1.05rem;
	}

	.home-seo__item-body p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.home-seo__item-link {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-seo__item-link:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.home-seo__cats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.home-seo__faq-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.home-seo__faq-link {
			margin-top: 0;
			min-height: var(--touch-min, 2.75rem);
			display: inline-flex;
			align-items: center;
		}
	}

	@media (max-width: 480px) {
		.home-seo__cats {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.home-seo__faq {
			padding: 1.1rem 1rem 1.15rem;
			margin-top: 1.75rem;
		}

		.home-seo__item summary {
			min-height: var(--touch-min, 2.75rem);
			padding: 0.85rem 1rem;
		}
	}
</style>
