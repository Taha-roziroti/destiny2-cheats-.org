---
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { forumsBasePath } from '../data/forums/helpers';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { affiliateLinkRel } from '../data/affiliate';
import { destiny2OfficialResources } from '../data/official-resources';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const year = new Date().getFullYear();
const shareUrl = `${siteConfig.url}/`;
const encodedUrl = encodeURIComponent(shareUrl);
const encodedName = encodeURIComponent(siteConfig.name);
const taglineLines = t('footer.tagline').split('\n');
const shareLinks = [
	{
		label: t('common.shareX'),
		href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedName}`,
	},
	{
		label: t('common.shareReddit'),
		href: `https://reddit.com/submit?url=${encodedUrl}&title=${encodedName}`,
	},
	{
		label: t('common.shareFacebook'),
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
];

const explore = [
	{ labelKey: 'nav.preview', href: getLocalizedPath('hacks', locale) },
	{ labelKey: 'nav.esp', href: getLocalizedPath('destiny-2-esp', locale) },
	{ labelKey: 'nav.aimbot', href: getLocalizedPath('destiny-2-aimbot', locale) },
	{ labelKey: 'common.featureList', href: getLocalizedPath('features', locale) },
	{ labelKey: 'common.pricingPlans', href: getLocalizedPath('pricing', locale) },
	{ labelKey: 'nav.forums', href: forumsBasePath },
	{ labelKey: 'nav.faq', href: getLocalizedPath('faq', locale) },
];

const help = [
	{ labelKey: 'nav.setup', href: getLocalizedPath('setup', locale) },
	{ labelKey: 'nav.updates', href: getLocalizedPath('updates', locale) },
	{ labelKey: 'common.buyerReviewsNav', href: reviewsBasePath },
	{ labelKey: 'common.support', href: getLocalizedPath('support', locale) },
	{ labelKey: 'common.privacy', href: getLocalizedPath('privacy', locale) },
	{ labelKey: 'common.terms', href: getLocalizedPath('terms', locale) },
];
---

<footer class="site-footer">
	<div class="shell site-footer__grid">
		<div class="site-footer__brand-col">
			<p class="site-footer__brand">{siteConfig.name}</p>
			{taglineLines.map((line) => <p class="site-footer__tagline">{line}</p>)}
			<a
				class="site-footer__cta"
				href={siteConfig.checkoutUrl}
				rel={affiliateLinkRel}
				aria-label={t('common.buyNow')}>{t('common.buyNow')}</a
			>
			<p class="site-footer__share-label">{t('common.share')}</p>
			<ul class="site-footer__share">
				{
					shareLinks.map((link) => (
						<li>
							<a href={link.href} rel="noopener noreferrer" target="_blank">{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="site-footer__label">{t('footer.explore')}</p>
			<ul>
				{
					explore.map((link) => (
						<li>
							<a href={link.href}>{t(link.labelKey)}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="site-footer__label">{t('footer.help')}</p>
			<ul>
				{
					help.map((link) => (
						<li>
							<a href={link.href}>{t(link.labelKey)}</a>
						</li>
					))
				}
				<li>
					<a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
				</li>
			</ul>
		</div>
		{
			destiny2OfficialResources.length > 0 && (
				<div>
					<p class="site-footer__label">{t('common.officialResources')}</p>
					<ul class="site-footer__resources-list">
						{
							destiny2OfficialResources.map((resource) => (
								<li>
									<a href={resource.href} rel="noopener noreferrer" target="_blank">
										{resource.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			)
		}
	</div>
	<div class="shell site-footer__bottom">
		<p>{t('common.copyright', { year, brand: siteConfig.name })}</p>
	</div>
</footer>

<style is:global>
	.site-footer {
		background:
			radial-gradient(ellipse 80% 60% at 50% 0%, color-mix(in srgb, var(--magenta-soft) 14%, transparent), transparent 55%),
			var(--bg-panel);
		border-top: 1px solid var(--line-soft);
		padding-top: clamp(2.5rem, 5vw, 3.5rem);
		content-visibility: auto;
		contain-intrinsic-size: 1px 420px;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem);
		padding-bottom: 2.5rem;
	}

	.site-footer__brand-col p.site-footer__tagline {
		max-width: 22rem;
	}

	.site-footer__tagline + .site-footer__tagline {
		margin-top: 0.25rem;
	}

	.site-footer__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 1rem;
		min-height: 2.5rem;
		padding: 0 1.15rem;
		border-radius: 999px;
		background: var(--accent);
		color: #fafbfd !important;
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.site-footer__cta:hover {
		background: var(--accent-hover);
		color: #fafbfd !important;
		transform: translateY(-1px);
	}

	.site-footer__resources-list a {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.site-footer__brand {
		display: block;
		margin: 0 0 0.65rem;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.site-footer__share-label {
		margin: 1.1rem 0 0.45rem !important;
		font-size: 0.75rem !important;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint) !important;
	}

	.site-footer__share {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
	}

	.site-footer__share a {
		font-size: 0.85rem;
		color: var(--ink-muted);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.site-footer__share a:hover {
		color: var(--magenta-soft);
	}

	.site-footer p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-faint);
		max-width: 20rem;
	}

	.site-footer__label {
		margin: 0 0 0.85rem !important;
		font-size: 0.75rem !important;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-muted) !important;
	}

	.site-footer ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.site-footer a:not(.site-footer__brand) {
		font-size: 0.875rem;
		color: var(--ink-muted);
	}

	.site-footer a:not(.site-footer__brand):hover {
		color: var(--ink);
	}

	.site-footer__bottom {
		border-top: 1px solid var(--line-soft);
		padding: 1.1rem 0 1.6rem;
	}

	.site-footer__bottom p {
		max-width: none;
		font-size: 0.75rem;
	}

	@media (max-width: 960px) {
		.site-footer__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.site-footer__brand-col {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 760px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.site-footer a:not(.site-footer__brand) {
			display: inline-flex;
			align-items: center;
			min-height: var(--touch-min, 2.75rem);
			overflow-wrap: anywhere;
		}

		.site-footer__bottom {
			padding-bottom: max(1.35rem, var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
		}
	}
</style>
