---
import { destinyImages } from '../data/destiny';
import { getUi } from '../data/i18n';
import { getGalleryUi } from '../data/i18n/gallery-ui';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { contentSrcSet, galleryTileSizes } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const gallery = getGalleryUi(locale);

const galleryAlts = [
	ui.images.cheatsPackage,
	ui.images.espWallhack,
	ui.images.aimbotCombat,
	ui.images.headerArt,
	ui.images.squadFight,
] as const;

const galleryImages = destinyImages.gallery.slice(0, 2).map((image, index) => ({
	src: image.src,
	alt: galleryAlts[index] ?? image.alt,
}));
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
	<h2 id="gallery-title" class="gallery__title">{gallery.title}</h2>
	<p class="gallery__sub">{gallery.subtitle}</p>

	<div class="gallery__grid">
		{
			galleryImages.map((image) => (
				<figure class="gallery__item media-frame">
					<img
						src={image.src}
						srcset={contentSrcSet(image.src)}
						sizes={galleryTileSizes}
						alt={image.alt}
						width="640"
						height="400"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			))
		}
	</div>
</section>

<style>
	.gallery__title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.gallery__sub {
		margin: 0.5rem 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.9375rem;
		line-height: 1.5;
		max-width: 36rem;
	}

	.gallery__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
	}

	.gallery__item {
		margin: 0;
		aspect-ratio: 16 / 10;
	}

	@media (max-width: 560px) {
		.gallery__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
